# Copy to docker/.env and fill in. `chmod 600 docker/.env`.
# docker/.env is gitignored (.gitignore covers .env and .env.*). Never commit
# values — this repo is public (§7.4).

# --- Anthropic ------------------------------------------------------------
# From `claude setup-token` on a machine where you are already signed in.
CLAUDE_CODE_OAUTH_TOKEN=

# --- Schwab ---------------------------------------------------------------
# From the Schwab Developer Portal app.
SCHWAB_CLIENT_ID=
SCHWAB_CLIENT_SECRET=

# --- Discord --------------------------------------------------------------
# Used by scripts/discord-notify.sh for pings and watchdog alerts.
#
# In Phases 1-3 these are given to the SCHEDULER only, never to the broker:
# handing them to the broker is what registers the Schwab write tools
# (cli.py:310). That is Phase 4 and is gated on a §9 amendment.
SCHWAB_MCP_DISCORD_TOKEN=
SCHWAB_MCP_DISCORD_CHANNEL_ID=
SCHWAB_MCP_DISCORD_APPROVERS=

# --- Paths ----------------------------------------------------------------
# Host path of the PRIVATE sidecar data repo (research/, status/, trade-log.csv).
TC_DATA_DIR=../../trade-challenge-store

# The full image reference. Normally :latest; scripts/deploy.sh overrides it
# with a digest (…@sha256:…) when rolling back, and writes the previous one to
# docker/.deployed-digest.
TC_IMAGE=ghcr.io/kilowhisky/trade-challenge:latest
